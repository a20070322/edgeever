{
  "openapi": "3.1.0",
  "info": {
    "title": "EdgeEver file workspace extensions",
    "version": "1.74.0-kw.1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    }
  ],
  "paths": {
    "/api/v1/file-workspace": {
      "get": {
        "summary": "Discover file-workspace identity and atomic revision write support",
        "description": "Requires read:memos and read:notebooks. File clients must validate server URL and workspaceId before syncing.",
        "responses": {
          "200": {
            "description": "File workspace capability",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "protocolVersion",
                    "atomicRevisionWrites",
                    "workspaceId"
                  ],
                  "properties": {
                    "protocolVersion": {
                      "type": "integer",
                      "const": 1
                    },
                    "attachmentSync": {
                      "type": "boolean",
                      "const": true
                    },
                    "atomicRevisionWrites": {
                      "type": "boolean",
                      "const": true
                    },
                    "workspaceId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient scopes"
          }
        }
      }
    },
    "/api/v1/resources/{id}": {
      "get": {
        "summary": "Get resource metadata and stable application URL",
        "description": "Requires read:resources; results are scoped to the authenticated workspace.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resource metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resource": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Insufficient scopes"
          },
          "404": {
            "description": "Resource or memo not found"
          }
        }
      }
    },
    "/api/v1/memos/{id}/resources": {
      "get": {
        "summary": "List active resources for an accessible memo",
        "description": "Requires read:resources; results are scoped to the authenticated workspace.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resource metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resources": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Insufficient scopes"
          },
          "404": {
            "description": "Resource or memo not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "edgeever_session"
      }
    }
  }
}
